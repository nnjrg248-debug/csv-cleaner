{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "localhost に対して Chrome を起動する",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}",
            "disableNetworkCache": true,
            "pathMapping": {
                "/": "${workspaceFolder}"
            },
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        }
    ]
}
